[nemesis]
version=1.1
id=hmgapi
name=HMG-API
type=application
package-version=@PACKAGE_VERSION@
short-desc="Mod manager for Gen5W head units: hooks, mods, Car Report."
detailed-desc="HMG-API @VERSION@: a root daemon, a hook runtime and the HMG-API app. Mods (wireless CarPlay and Android Auto, and more) are added from the app. Uninstalling puts every file back to stock."
os="any"
models="any"
depends="@DEPENDS@"
postinstall=scripts/postinstall.sh
preuninstall=scripts/preuninstall.sh

[app.0]
kind=sh
path=bin/open.sh
uid=root

[service.0]
name=boot
kind=sh
path=bin/start.sh
uid=root
mode=background
