<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="hmgapi.app"
    android:versionCode="9"
    android:versionName="1.0.2">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />

    <!-- this head unit's activity manager checks GET_TASKS even in finish() -->
    <uses-permission android:name="android.permission.GET_TASKS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_hmgapi"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Holo.NoActionBar">
        <!-- no LAUNCHER category: the stock launcher only shows its built-in list;
             HMG-API's hooks add the tile and the star key choice -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity
            android:name=".UpdatesActivity"
            android:label="@string/app_name" />
        <!-- the owner's OK for a mod's first car command (opened by the vehicle service) -->
        <activity
            android:name=".AskActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Holo.Dialog.NoActionBar"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />
        <!-- mods' USB folders (mod.json "usb"): their apps hear when a stick with it comes and goes -->
        <receiver android:name=".UsbFolders">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <action android:name="android.intent.action.MEDIA_EJECT" />
                <action android:name="android.intent.action.MEDIA_UNMOUNTED" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
