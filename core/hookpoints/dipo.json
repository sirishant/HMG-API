{
  "app": "dipo",
  "package": "com.daudio.app.dipo",
  "files": [
    "/system/app/HKMC_DiPO.odex",
    "/system/framework/com.tcc.iap2.odex",
    "/system/framework/com.broadcom.bt.jar"
  ],
  "patterns": {
    "iap2_notify_flag": {
      "in": "@dipo.iap2_listener",
      "regex": "\\.method public final connected\\(ILjava/lang/String;\\)V\\n(?:.*\\n)*?invoke-static \\{v\\d+, v\\d+\\}, L[\\w/$]+;->(?P<set>\\w+)\\(L[\\w/$]+;Z\\)Z\\n",
      "about": "on connect DiPO's iAP2 listener turns its manager's notification flag on, through a static setter"
    },
    "session_bt_address": {
      "in": "@dipo.session_listener",
      "regex": "invoke-virtual \\{v\\d+\\}, L[\\w/$]+;->(?P<address>\\w+)\\(\\)Ljava/lang/String;\\nmove-result-object v\\d+\\ninvoke-virtual \\{v\\d+\\}, Ljava/lang/String;->toUpperCase\\(\\)Ljava/lang/String;\\n",
      "about": "onSessionDetails reads the iAP2 manager's Bluetooth address and upper-cases it"
    },
    "screen_mode_local_on": {
      "in": "@dipo.activity_handler",
      "regex": "const-string v\\d+, \"HANDLER_MESSAGE_SCREEN_MODE_CHECK isLocalScreenOnOffstate\\(\\) : \"\\n(?:.*\\n)*?invoke-virtual \\{v\\d+\\}, Lcom/daudio/app/dipo/service/DipoService;->(?P<on>\\w+)\\(\\)Z\\n",
      "about": "the screen-mode check logs DipoService's local-screen-on flag"
    }
  },
