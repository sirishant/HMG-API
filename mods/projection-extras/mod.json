{
  "id": "projection-extras",
  "name": "Projection extras",
  "version": "1.1.5",
  "hmgapi": ">=1.0.5",
  "authors": [
    "sirishant"
  ],
  "repo": "https://github.com/sirishant/HMG-API",
  "license": "AGPL-3.0",
  "description": "Android Auto and CarPlay take turns, voice, and the Call, Media, NAV and MAP buttons; CarPlay session and call fixes.",
  "system": {
    "model": [
      "SU2IEV"
    ],
    "region": "IND",
    "firmware": "260430"
  },
  "requires": [
    "wireless-carplay-aa ^2.4"
  ],
  "logs": {
    "tags": [
      "DiPO",
      "PhoneProjection"
    ],
    "match": [
      "switch:",
      "CarPlay:",
      "iAP2:",
      "Android Auto:",
      "PhoneProjection:"
    ]
  },
  "hooks": {
    "jar": "hooks.jar",
    "entry": "hmgapi.mods.projextras.Switch",
    "points": {
      "dipo.service.dipo_activated": "observe",
      "framework.context_wrapper.send_broadcast": "change",
      "dipo.carplay_listener.decode_failure": "observe",
      "dipo.carplay.session_started": "observe",
      "dipo.carplay.session_finalized": "observe",
      "dipo.activity.set_display": "observe",
      "dipo.activity.on_destroy": "observe",
      "dipo.service.set_display": "observe",
      "dipo.service.post_message": "change",
      "dipo.activity_handler.handle_message": "replace",
      "dipo.activity.dispatch_key_event": "replace",
      "dipo.service.call_key": "observe",
      "dipo.service.no_call_message": "replace",
      "iap2.service.send_accessory_config": "change",
      "iap2.service.set_wireless_carplay_status": "observe",
      "phoneprojection.wireless_service.on_create": "observe",
      "phoneprojection.wireless_service.on_destroy": "observe",
      "phoneprojection.device_status_receiver.on_receive": "observe",
      "phoneprojection.wireless_receiver.on_receive": "replace",
      "phoneprojection.wireless_service.connect_handler": "replace",
      "phoneprojection.wireless_service.disconnect_handler": "replace",
      "phoneprojection.binder.disconnect_pp": "observe",
      "phoneprojection.wireless_service.connect_device": "change",
      "gpm.key_listener.key_for_service": "observe",
      "gpm.util.spec_step": "change",
      "gpm.receiver_service.on_create": "observe",
      "gpm.main_activity.on_key_up": "replace",
      "gpm.receiver_service.send_osd_message": "replace",
      "dipo.service.start_carplay_session": "observe",
      "dipo.call_utils.is_bt_call": "observe",
      "gpm.key_listener.all_keys": "observe",
      "gpm.main_activity.on_resume": "observe",
      "framework.hkmc_loader.automotive_service": "observe",
      "framework.mode_key_dispatcher.send_broadcast_key_event": "observe",
      "framework.mode_key_dispatcher.request_shortcut": "replace"
    }
  },
  "input": [
    {
      "key": "ptt",
      "press": "short",
      "send": "ptt hold"
    },
    {
      "key": "ptt",
      "press": "hold",
      "send": "ptt short"
    }
  ]
}
