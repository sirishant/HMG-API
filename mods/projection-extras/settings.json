{
  "version": 1,
  "settings": [
    {
      "key": "voice_swap",
      "type": "toggle",
      "default": true,
      "apply": "rebuild",
      "title": "Voice button: press for phone, hold for car (test)"
    },
    {
      "key": "carplay_screen_retry",
      "type": "toggle",
      "default": true,
      "apply": "restart",
      "title": "CarPlay screen: retry for 15 s (test)"
    },
    {
      "key": "aa_call_key",
      "type": "toggle",
      "default": true,
      "apply": "restart",
      "title": "Call button opens Android Auto's phone (test)"
    },
    {
      "key": "aa_media_key",
      "type": "toggle",
      "default": true,
      "apply": "restart",
      "title": "Media button opens Android Auto's media; hold for the car's (test)"
    },
    {
      "key": "aa_nav_key",
      "type": "toggle",
      "default": true,
      "apply": "restart",
      "title": "NAV and MAP buttons open Android Auto's navigation; hold for the car's (test)"
    },
    {
      "key": "carplay_keys",
      "type": "toggle",
      "default": true,
      "apply": "restart",
      "title": "CarPlay: NAV/MAP open Maps, Media Now Playing, Call the Phone app (untried test)"
    }
  ]
}
