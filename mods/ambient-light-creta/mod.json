{
  "id": "ambient-light-creta",
  "name": "Ambient light (Creta)",
  "version": "1.0.0",
  "hmgapi": ">=1.0.6",
  "authors": [
    "sirishant"
  ],
  "repo": "https://github.com/sirishant/HMG-API",
  "license": "AGPL-3.0",
  "description": "Creta Electric India only. Choose the ambient light's colour and brightness (the car has no menu for it). Turned off or removed, the car's own blue comes back.",
  "system": {
    "model": [
      "SU2IEV"
    ],
    "region": "IND",
    "firmware": "260430"
  },
  "services": [
    {
      "name": "light",
      "script": "svc/light.sh",
      "user": "system",
      "start": "android",
      "restart": true
    }
  ],
  "vehicle": {
    "read": [
      "ignition"
    ],
    "commands": [
      "ambient_light"
    ]
  }
}
