{
  "id": "wireless-creta-rhd",
  "name": "Creta cluster display (RHD)",
  "version": "1.3.0",
  "hmgapi": ">=1.0.0",
  "authors": [
    "sirishant"
  ],
  "license": "AGPL-3.0",
  "description": "Creta Electric India only. Android Auto and CarPlay turns on the cluster: near scenes, bar, roundabouts.",
  "system": {
    "model": [
      "SU2IEV"
    ],
    "region": "IND",
    "firmware": "260430"
  },
  "requires": [
    "wireless-carplay-aa ^2.5"
  ],
  "logs": {
    "tags": [
      "GPM"
    ],
    "match": [
      "Creta cluster display"
    ]
  },
  "hooks": {
    "jar": "hooks.jar",
    "entry": "hmgapi.mods.creta.CretaMod",
    "points": {
      "framework.navigation_cluster.update_tbt_trap_info": "observe",
      "framework.navigation_cluster.update_tbt_trap_info_new": "observe"
    }
  }
}
