{
  "id": "lamp-test-creta",
  "name": "Lamp test (Creta, one-off)",
  "version": "1.0.2",
  "hmgapi": ">=1.0.5",
  "authors": [
    "sirishant"
  ],
  "repo": "https://github.com/sirishant/HMG-API",
  "license": "AGPL-3.0",
  "description": "Creta Electric India only. Once, parked: the ambient light at full brightness for 15 s, off for 10 s, then the car's own level back. Remove it after the test.",
  "system": {
    "model": [
      "SU2IEV"
    ],
    "region": "IND",
    "firmware": "260430"
  },
  "services": [
    {
      "name": "lamp-test",
      "script": "svc/lamp-test.sh",
      "user": "system",
      "start": "android",
      "restart": false
    }
  ],
  "vehicle": {
    "read": [
      "gear.park"
    ],
    "commands": [
      "ambient_light"
    ]
  }
}
